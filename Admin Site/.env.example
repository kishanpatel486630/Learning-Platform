# Admin Site - Environment Variables

# Flask Settings
FLASK_DEBUG=true
ADMIN_SECRET_KEY=change-this-to-a-random-super-secret-key

# MongoDB Connection
# Replace this with your actual MongoDB Atlas cluster URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=learnpath

# JWT Authentication
ADMIN_JWT_SECRET=change-this-jwt-secret-key

# CORS
# Adjust this for production (e.g., https://your-admin-site.vercel.app)
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:5500,http://127.0.0.1:5500
