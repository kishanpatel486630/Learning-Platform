# Admin Site - Environment Variables

# Flask Settings
FLASK_DEBUG=true
ADMIN_SECRET_KEY=learnpath-admin-secret-key-2025

# MongoDB Connection (same database as User Site)
MONGO_URI=mongodb://localhost:27017/learnpath
MONGO_DB_NAME=learnpath

# JWT Authentication
ADMIN_JWT_SECRET=learnpath-admin-jwt-secret-2025

# CORS
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:5500,http://127.0.0.1:5500
